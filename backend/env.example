# ─────────────────────────────────────────────────────────────────────────────
# MediFlow-AI — Backend Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Auth Configuration (Server-Side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL / Supabase Database Connection
# Standard Supabase Direct / Transaction Pooler connection string:
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres
# Or local connection:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=MedFlow-AI;Username=postgres;Password=yourpassword

# JWT Fallback (For local development and integration tests)
Jwt__Key=MediFlowAI_Sec_9f82d1c4b7a63e50821cde458291f034a71c50b8923d
Jwt__Issuer=https://api.mediflow.ai
Jwt__Audience=https://mediflow.ai

# AI Microservice Base URL
AiService__BaseUrl=http://localhost:8000
