# ── Medication Intelligence Agent (Agent 3) ───────────────────────────────────
# Gemini API key — used to generate pharmacist-readable clinical summaries.
# Falls back to deterministic summary if not set or on timeout (safe to leave blank locally).
GEMINI_API_KEY=your_gemini_api_key_here

# ── Inventory Intelligence Agent (Agent 4) ────────────────────────────────────
# URL of the MediFlow ASP.NET backend API (no trailing slash)
BACKEND_URL=http://localhost:5000

# Service-to-service JWT token for the AI service to call protected backend endpoints.
# Generate by logging in as PharmacyOwner or Administrator and copying the token.
# Never commit a real token to source control.
BACKEND_SERVICE_TOKEN=

# Optional: override the Gemini model used by the agents
# GEMINI_MODEL=gemini-1.5-flash
