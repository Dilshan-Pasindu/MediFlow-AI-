# ─────────────────────────────────────────────────────────────────────────────
# MediFlow-AI — Frontend Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5224/api

# Supabase Auth Configuration (Client-Safe Anon Key & Project URL)
# Note: Never place service-role keys or database credentials in the frontend!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google OAuth Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
